{
  "name": "muzik",
  "version": "1.0.0",
  "description": "MUZIK — Local Editorial Music Player",
  "author": "MUZIK",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "electron": "vite build && electron .",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "music-metadata": "^13.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.muzik.player",
    "productName": "MUZIK",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
